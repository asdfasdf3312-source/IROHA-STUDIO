<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>협업 작가 소개 v1</title>
<style>
@font-face{font-family:'Paperozi';src:url('https://cdn.jsdelivr.net/gh/projectnoonnu/2408-3@1.0/Paperlogy-4Regular.woff2') format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Paperozi';src:url('https://cdn.jsdelivr.net/gh/projectnoonnu/2408-3@1.0/Paperlogy-7Bold.woff2') format('woff2');font-weight:700;font-display:swap}
:root{
  --mint:#76D8D2;--mint-deep:#3DB9B1;--mint-dark:#299A94;--mint-soft:#EFFFFD;
  --lav:#F3F0FF;--lav-deep:#8172E8;--ink:#313E42;--sub:#7D8B90;--line:#BFEDEA;
  --shadow:0 18px 42px rgba(61,185,177,.15)
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:transparent;color:var(--ink);font-family:'Paperozi',sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{padding:30px 14px 42px}
.collab-wrap{width:100%;max-width:980px;margin:0 auto}
.collab-section{
  position:relative;overflow:hidden;border:1.5px solid var(--line);border-radius:32px;
  background:radial-gradient(circle at 3% 0%,rgba(118,216,210,.28),transparent 34%),
             radial-gradient(circle at 100% 100%,rgba(129,114,232,.16),transparent 32%),
             linear-gradient(135deg,rgba(255,255,255,.96),rgba(246,255,254,.94));
  box-shadow:var(--shadow);padding:34px
}
.collab-section::after{content:"";position:absolute;right:-80px;top:-80px;width:220px;height:220px;border-radius:70px;transform:rotate(18deg);background:rgba(118,216,210,.16);pointer-events:none}
.collab-head{position:relative;z-index:1;margin-bottom:22px}
.title-box{display:flex;align-items:flex-start;gap:11px}
.title-bar{width:6px;height:28px;border-radius:999px;background:linear-gradient(180deg,var(--mint),var(--lav-deep));flex:0 0 auto;margin-top:2px}
.kicker{display:inline-flex;width:max-content;margin-bottom:7px;padding:6px 11px;border-radius:999px;background:rgba(118,216,210,.16);border:1px solid rgba(118,216,210,.36);color:var(--mint-dark);font-size:12px;font-weight:700;letter-spacing:.02em}
.collab-title{margin:0;color:#2D3D41;font-size:24px;line-height:1.25;font-weight:700;letter-spacing:-.04em}
.collab-desc{margin:8px 0 0;color:var(--sub);font-size:13.5px;line-height:1.65;word-break:keep-all}
.artist-card{
  position:relative;z-index:1;display:grid;grid-template-columns:360px minmax(0,1fr);gap:22px;padding:18px;
  border-radius:26px;border:1px solid rgba(191,237,234,.92);background:rgba(255,255,255,.82);
  box-shadow:0 12px 26px rgba(61,185,177,.10),inset 0 0 0 1px rgba(255,255,255,.82);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)
}
.artist-visual{position:relative;overflow:hidden;min-height:252px;border-radius:22px;background:linear-gradient(135deg,rgba(239,247,255,.9),rgba(239,255,253,.95));border:1px solid rgba(191,237,234,.92)}
.artist-visual::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 20% 18%,rgba(118,216,210,.25),transparent 30%),radial-gradient(circle at 88% 22%,rgba(129,114,232,.18),transparent 28%);pointer-events:none}
.thumb-grid{position:absolute;inset:14px;display:grid;grid-template-columns:1.1fr .9fr;grid-template-rows:1fr 1fr;gap:10px}
.thumb{position:relative;overflow:hidden;border-radius:18px;background:#fff;border:1px solid rgba(255,255,255,.9);box-shadow:0 8px 18px rgba(61,185,177,.12)}
.thumb:first-child{grid-row:1 / 3}
.thumb img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;-webkit-user-drag:none;user-select:none}
.thumb.placeholder{display:grid;place-items:center;padding:18px;text-align:center;color:var(--mint-dark);font-size:13px;font-weight:700;line-height:1.5;background:linear-gradient(135deg,rgba(255,255,255,.86),rgba(239,255,253,.96))}
.thumb.placeholder::after{content:"이미지를 준비해주세요";white-space:pre-line}
.visual-label{position:absolute;left:18px;bottom:18px;z-index:3;display:inline-flex;align-items:center;gap:7px;padding:8px 12px;border-radius:999px;color:#fff;background:linear-gradient(135deg,var(--mint-deep),var(--lav-deep));box-shadow:0 8px 20px rgba(61,185,177,.22);font-size:12px;font-weight:700}
.artist-info{min-width:0;display:flex;flex-direction:column;justify-content:center;padding:10px 8px 8px 2px}
.artist-topline{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:10px}
.role-chip{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;background:var(--lav);color:var(--lav-deep);font-size:12px;font-weight:700}
.artist-name{margin:0 0 9px;color:#2D3D41;font-size:25px;line-height:1.25;font-weight:700;letter-spacing:-.04em}
.artist-sub{margin:0 0 13px;color:var(--mint-dark);font-size:14px;line-height:1.55;font-weight:700}
.artist-text{margin:0;color:#617174;font-size:14px;line-height:1.75;word-break:keep-all}
.tag-row{display:flex;flex-wrap:wrap;gap:7px;margin:17px 0 18px}
.tag{display:inline-flex;align-items:center;padding:7px 10px;border-radius:999px;background:rgba(118,216,210,.14);border:1px solid rgba(118,216,210,.32);color:#3C8580;font-size:12.5px;font-weight:700}
.info-note{margin:0 0 18px;padding:12px 13px;border-radius:16px;background:rgba(239,247,255,.72);border:1px solid rgba(184,218,255,.72);color:#64757A;font-size:12.8px;font-weight:700;line-height:1.6;word-break:keep-all}
.action-row{display:flex;flex-wrap:wrap;align-items:center;gap:9px}
.artist-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:138px;padding:12px 16px;border-radius:999px;color:#fff;background:linear-gradient(135deg,var(--mint-deep),var(--lav-deep));box-shadow:0 10px 22px rgba(61,185,177,.22);font-size:13px;font-weight:700;line-height:1;text-decoration:none;transition:transform .18s ease,box-shadow .18s ease,filter .18s ease}
.artist-btn:hover{transform:translateY(-1px);box-shadow:0 13px 26px rgba(61,185,177,.28);filter:saturate(1.04)}
.sub-link{color:var(--sub);font-size:12.5px;line-height:1.5;font-weight:700}
.notice{position:relative;z-index:1;margin:14px 0 0;color:var(--sub);font-size:12.5px;line-height:1.6;text-align:center;word-break:keep-all}
@media(max-width:820px){.collab-section{padding:26px 18px}.artist-card{grid-template-columns:1fr;gap:18px}.artist-visual{min-height:300px}.artist-info{padding:0 2px 4px}}
@media(max-width:520px){body{padding:20px 10px 32px}.collab-section{border-radius:24px;padding:22px 14px}.collab-title{font-size:21px}.artist-card{padding:13px;border-radius:22px}.artist-visual{min-height:270px;border-radius:19px}.thumb-grid{inset:10px;gap:8px}.thumb{border-radius:15px}.artist-name{font-size:22px}.artist-text{font-size:13.5px}}
</style>
</head>
<body>
<section class="collab-wrap" aria-label="협업 작가 소개">
  <div class="collab-section">
    <div class="collab-head">
      <div class="title-box">
        <div class="title-bar" aria-hidden="true"></div>
        <div>
          <div class="kicker">COLLABORATION ARTIST</div>
          <h1 class="collab-title">협업 작가 소개</h1>
          <p class="collab-desc">
            이로하 작업과 함께 참고하면 좋은 협업 작가님을 소개합니다.<br>
            원화·헤드 디자인이 필요한 경우 작업 방향에 맞춰 함께 확인해주세요.
          </p>
        </div>
      </div>
    </div>

    <article class="artist-card">
      <div class="artist-visual">
        <div class="thumb-grid">
          <div class="thumb"><img src="./images/collab/hirune-01.png" alt="히루네 작가 대표 이미지 1" loading="eager" onerror="this.parentElement.classList.add('placeholder');this.remove();"></div>
          <div class="thumb"><img src="./images/collab/hirune-02.png" alt="히루네 작가 대표 이미지 2" loading="lazy" onerror="this.parentElement.classList.add('placeholder');this.remove();"></div>
          <div class="thumb"><img src="./images/collab/hirune-03.png" alt="히루네 작가 대표 이미지 3" loading="lazy" onerror="this.parentElement.classList.add('placeholder');this.remove();"></div>
        </div>
        <div class="visual-label">IROHA PICK</div>
      </div>

      <div class="artist-info">
        <div class="artist-topline"><span class="role-chip">원화 · 헤드 디자인</span></div>
        <h2 class="artist-name">히루네 작가</h2>
        <p class="artist-sub">버츄얼 헤드 / 원화 일러스트 협업 작가</p>
        <p class="artist-text">
          캐릭터의 얼굴 인상과 분위기를 섬세하게 잡아주는 작가님입니다.
          이로하 작업 신청 시 원화 기반 디자인이나 헤드 이미지 참고자료가 필요한 경우,
          작업 방향에 따라 함께 확인하기 좋습니다.
        </p>

        <div class="tag-row" aria-label="작업 태그">
          <span class="tag">#버츄얼헤드</span>
          <span class="tag">#원화일러스트</span>
          <span class="tag">#캐릭터디자인</span>
          <span class="tag">#협업가능</span>
        </div>

        <p class="info-note">※ 작가님 작업 가능 여부와 세부 금액은 작가 페이지 기준으로 확인해주세요.</p>

        <div class="action-row">
          <a class="artist-btn" href="https://artmug.kr/index.php?channel=view&uid=60421" target="_blank" rel="noopener">작가 페이지 →</a>
          <span class="sub-link">아트머그 작가 페이지로 이동합니다.</span>
        </div>
      </div>
    </article>

    <p class="notice">※ 협업 작가 소개는 작업 선택을 돕기 위한 안내이며, 실제 의뢰는 각 작가 페이지의 안내 기준을 따릅니다.</p>
  </div>
</section>

<script>
(function(){
  function sendHeight(){
    var h=Math.max(document.body?document.body.scrollHeight:0,document.documentElement?document.documentElement.scrollHeight:0);
    try{parent.postMessage({type:'iroha-collab-artist-height',height:h},'*')}catch(e){}
  }
  window.addEventListener('load',function(){sendHeight();setTimeout(sendHeight,150);setTimeout(sendHeight,500);setTimeout(sendHeight,1200)});
  window.addEventListener('resize',sendHeight);
  if(document.fonts&&document.fonts.ready){document.fonts.ready.then(sendHeight)}
  if('ResizeObserver' in window){var ro=new ResizeObserver(sendHeight);ro.observe(document.body)}
})();
</script>
</body>
</html>
